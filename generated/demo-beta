# /etc/network/interfaces: создан generate_interfaces.py
# Сервер: demo-beta
# Маршрутизация: IP источника -> tabel<VLAN>, прямой маршрут + шлюз VLAN.
# Основной default route: VLAN 171 (192.0.2.1).
source /etc/network/interfaces.d/*

auto lo
iface lo inet loopback

# ---------- bond7: LACP (enp5s0f0, enp5s0f1) ----------
auto enp5s0f0
iface enp5s0f0 inet manual
    mtu 9000

auto enp5s0f1
iface enp5s0f1 inet manual
    mtu 9000

auto bond7
iface bond7 inet manual
    pre-up modprobe bonding
    bond-mode 802.3ad
    bond-miimon 100
    bond-downdelay 200
    bond-updelay 200
    bond-xmit-hash-policy layer3+4
    bond-slaves enp5s0f0 enp5s0f1
    mtu 9000

# ---------- VLAN 171 (tagged): Sample access network ----------
auto bond7.171
iface bond7.171 inet manual
    vlan-raw-device bond7
    mtu 1500

auto br171
iface br171 inet static
    bridge_ports bond7.171
    bridge_stp off
    bridge_fd 0
    mtu 1500
    address 192.0.2.3
    netmask 255.255.255.248
    gateway 192.0.2.1
    post-up ip route replace 192.0.2.0/29 dev br171 scope link src 192.0.2.3 table tabel171
    post-up ip route replace default via 192.0.2.1 dev br171 table tabel171
    post-up ip rule del pref 10171 from 192.0.2.3/32 lookup tabel171 2>/dev/null || true
    post-up ip rule add pref 10171 from 192.0.2.3/32 lookup tabel171
    pre-down ip rule del pref 10171 from 192.0.2.3/32 lookup tabel171 2>/dev/null || true
    pre-down ip route del default via 192.0.2.1 dev br171 table tabel171 2>/dev/null || true
    pre-down ip route del 192.0.2.0/29 dev br171 table tabel171 2>/dev/null || true

